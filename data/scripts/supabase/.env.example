# Supabase Database Configuration
# 
# Get this from Supabase Dashboard:
# 1. Go to Project → Database → Connection Pooler
# 2. Select "Connection string" tab
# 3. Copy the URL (replace [YOUR-PASSWORD] with your actual password)

DB_CONNECTION_STRING=

# Alternative: Use direct connection (slower but simpler for local dev)
# DB_CONNECTION_STRING=postgresql://postgres:[YOUR-PASSWORD]@aws-1-ap-south-1.supabase.co:5432/postgres
