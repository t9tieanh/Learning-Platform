{
  "info": {
    "_postman_id": "a1b2c3d4-lesson-test-student",
    "name": "Assistant — Lesson test (học viên)",
    "description": "GET đề + POST nộp bài. Điền collection variables: baseUrl, token, lessonId.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:4000" },
    { "key": "token", "value": "" },
    { "key": "lessonId", "value": "" }
  ],
  "item": [
    {
      "name": "GET — Lấy đề (student)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}",
            "type": "text"
          }
        ],
        "url": "{{baseUrl}}/analysis/lessons/{{lessonId}}/lesson-test/student",
        "description": "Middleware: JWT + checkViewLesson."
      },
      "response": []
    },
    {
      "name": "POST — Nộp bài / chấm điểm",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"answers\": [\n    {\n      \"quizId\": \"REPLACE_QUIZ_UUID\",\n      \"selectedChoiceIds\": [\"REPLACE_CHOICE_UUID\"]\n    }\n  ]\n}"
        },
        "url": "{{baseUrl}}/analysis/lessons/{{lessonId}}/lesson-test/student/submissions",
        "description": "Sửa body: quizId / selectedChoiceIds từ response GET."
      },
      "response": []
    }
  ]
}
