generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [uuid_ossp(map: "uuid-ossp", schema: "extensions"), vector]
}

model CourseEmbedding {
  id          String                 @id @db.VarChar
  name        String
  description String
  tags        String[]
  createdAt   DateTime?              @default(now()) @map("created_at") @db.Timestamp(6)
  link        String?
  content     String?
  metadata    Json?
  check       Boolean                @default(false)
  embedding   Unsupported("vector")?

  @@index([embedding])
  @@map("course_embeddings")
}

model LessonChunk {
  id                 String                 @id @default(uuid())
  lessonId           String
  content            String
  chunkIndex         Int
  subtitleIndex      Int?
  startTime          String?
  endTime            String?
  timestamp          String?
  sentenceCount      Int?
  startSentenceIndex Int?
  endSentenceIndex   Int?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  summary            String?
  embedding          Unsupported("vector")?
  title              String?
  lesson             Lesson                 @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  quizzes            Quiz[]

  @@map("lesson_chunks")
}

/// Lesson-level test blueprint — optional 1:1 with Lesson (PK/FK `lesson_id`).
model LessonTest {
  lessonId             String           @id @map("lesson_id")
  title                String?
  status               LessonTestStatus @default(DRAFT)
  targetTotalQuestions Int?             @map("target_total_questions")
  notes                String?
  createdBy            String           @map("created_by")
  createdAt            DateTime         @default(now()) @map("created_at")
  updatedAt            DateTime         @updatedAt @map("updated_at")

  lesson      Lesson                   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  chunkGroups LessonTestChunkGroup[]

  @@map("lesson_tests")
}

/// Chunk group within a lesson test blueprint (`chunk_ids`: JSON array of `lesson_chunks.id`).
model LessonTestChunkGroup {
  id               String   @id @default(uuid())
  lessonId         String   @map("lesson_id")
  chunkIds         Json     @map("chunk_ids")
  label            String?
  questionCount    Int      @map("question_count")
  distribution     Json?
  batchUserPrompt  String?  @map("batch_user_prompt")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  lessonTest LessonTest @relation(fields: [lessonId], references: [lessonId], onDelete: Cascade)
  quizzes    Quiz[]

  @@index([lessonId])
  @@map("lesson_test_chunk_groups")
}

model LessonTestSubmission {
  id           String   @id @default(uuid())
  lessonId     String   @map("lesson_id")
  userId       String   @map("user_id")
  earnedPoints Float    @map("earned_points")
  maxPoints    Int      @map("max_points")
  percent      Float
  createdAt    DateTime @default(now()) @map("created_at")

  lesson  Lesson                       @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  answers LessonTestSubmissionAnswer[]

  @@index([lessonId, userId])
  @@map("lesson_test_submissions")
}

model LessonTestSubmissionAnswer {
  id                String   @id @default(uuid())
  submissionId      String   @map("submission_id")
  quizId            String   @map("quiz_id")
  selectedChoiceIds Json     @map("selected_choice_ids")
  isCorrect         Boolean  @map("is_correct")
  pointsEarned      Float    @map("points_earned")

  submission LessonTestSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  quiz       Quiz                 @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@index([submissionId])
  @@map("lesson_test_submission_answers")
}

model Lesson {
  id             String         @id @default(uuid())
  title          String?
  content        String?
  duration       Int?
  position       Int?
  isPublic       Boolean?       @default(false)
  type           String?
  url            String?
  chapterId      String?
  transcriptId   String?        @unique
  transcript     String?
  summary        String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  deleted        Boolean        @default(false)
  subtitles      String?
  suggestedTitle String?
  isQualityValid Boolean?       @default(true)
  qualityReason  String?
  status         AnalysisStatus @default(PROCESSING)
  chunks                  LessonChunk[]
  lessonTest              LessonTest?
  lessonTestSubmissions   LessonTestSubmission[]

  @@map("lessons")
}

/// Chat threads per (logical) lesson id from the platform. No FK to `lessons` — ids may exist before analysis ingests the row.
model LessonChatSession {
  id          String   @id @default(uuid())
  lessonId    String   @map("lesson_id")
  userId      String   @map("user_id")
  title       String?
  summaryLast String?  @map("summary_last")
  notes       String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  messages LessonChatMessage[]

  @@index([lessonId, userId])
  @@map("lesson_chat_sessions")
}


model LessonChatMessage {
  id        String                @id @default(uuid())
  sessionId String                @map("session_id")
  role      LessonChatMessageRole
  content   String                @db.Text
  metadata  Json?
  embedding Unsupported("vector")?
  createdAt DateTime              @default(now()) @map("created_at")

  session LessonChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@map("lesson_chat_messages")
}

model NavigatorEmbedding {
  id          String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  category    String
  subcategory String?
  title       String?
  content     String
  metadata    Json?
  createdAt   DateTime?              @default(now()) @map("created_at") @db.Timestamptz(6)
  check       Boolean?               @default(true)
  embedding   Unsupported("vector")?

  @@map("navigator_embeddings")
}

model QuizChoice {
  id           String         @id @default(uuid())
  quizId       String
  text         String
  isCorrect    Boolean        @default(false)
  order        Int
  feedback     String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  quiz         Quiz           @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@index([quizId])
  @@map("quiz_choices")
}

model Quiz {
  id                      String                @id @default(uuid())
  /// Nullable when `quizScope === LESSON_TEST` (group grounded via `lessonTestChunkGroupId`).
  chunkId                 String?
  quizScope               QuizScope             @default(CHUNK_STANDALONE) @map("quiz_scope")
  lessonTestChunkGroupId  String?               @map("lesson_test_chunk_group_id")
  question                String
  explanation             String
  type                    QuestionType          @default(MULTIPLE_CHOICE)
  difficulty              DifficultyLevel       @default(MEDIUM)
  bloomLevel              BloomLevel            @default(REMEMBER)
  aiGenerated             Boolean               @default(false)
  aiModel                 String?
  aiConfidence            Float?
  createdBy               String
  isApproved              Boolean               @default(false)
  status                  QuizStatus            @default(ACTIVE)
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt
  choices                 QuizChoice[]
  chunk                   LessonChunk?          @relation(fields: [chunkId], references: [id], onDelete: Cascade)
  lessonTestChunkGroup    LessonTestChunkGroup? @relation(fields: [lessonTestChunkGroupId], references: [id], onDelete: SetNull)
  lessonTestSubmissionAnswers LessonTestSubmissionAnswer[]

  @@index([aiGenerated])
  @@index([chunkId])
  @@index([createdBy])
  @@index([isApproved])
  @@index([quizScope])
  @@index([lessonTestChunkGroupId])
  @@map("quizzes")
}

model SystemProfileEmbedding {
  id          String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  category    String
  subcategory String?
  title       String?
  content     String
  metadata    Json?
  createdAt   DateTime?              @default(now()) @map("created_at") @db.Timestamptz(6)
  check       Boolean?
  embedding   Unsupported("vector")?

  @@map("system_profile_embeddings")
}

/// Supabase: public.user_purchased_courses (id bigint PK, user_id/course_id text, purchased_at timestamp)
model UserPurchasedCourse {
  id          BigInt    @id
  userId      String    @map("user_id") @db.Text
  courseId    String    @map("course_id") @db.Text
  purchasedAt DateTime? @default(now()) @map("purchased_at") @db.Timestamp()

  @@map("user_purchased_courses")
}

model n8n_chat_histories {
  id         Int    @id @default(autoincrement())
  session_id String @db.VarChar(255)
  message    Json
}

enum BloomLevel {
  REMEMBER
  UNDERSTAND
  APPLY
  ANALYZE
  EVALUATE
  CREATE
}

enum DifficultyLevel {
  EASY
  MEDIUM
  HARD
}

enum QuestionType {
  MULTIPLE_CHOICE
  TRUE_FALSE
  SHORT_ANSWER
}

enum QuizStatus {
  ACTIVE
  ARCHIVED
  FLAGGED
}

enum AnalysisStatus {
  PROCESSING
  COMPLETED
  FAILED
}

enum LessonTestStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum QuizScope {
  CHUNK_STANDALONE
  LESSON_TEST
}

enum LessonChatMessageRole {
  USER
  ASSISTANT
  SYSTEM
}
