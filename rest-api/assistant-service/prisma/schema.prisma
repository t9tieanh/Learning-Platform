generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [uuid_ossp(map: "uuid-ossp", schema: "extensions"), vector]
}

model CourseEmbedding {
  id          String                 @id @db.VarChar
  name        String
  description String
  tags        String[]
  createdAt   DateTime?              @default(now()) @map("created_at") @db.Timestamp(6)
  link        String?
  content     String?
  metadata    Json?
  check       Boolean                @default(false)
  embedding   Unsupported("vector")?

  @@index([embedding])
  @@map("course_embeddings")
}

model LessonChunk {
  id                 String                 @id @default(uuid())
  lessonId           String
  content            String
  chunkIndex         Int
  subtitleIndex      Int?
  startTime          String?
  endTime            String?
  timestamp          String?
  sentenceCount      Int?
  startSentenceIndex Int?
  endSentenceIndex   Int?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  summary            String?
  embedding          Unsupported("vector")?
  title              String?
  lesson             Lesson                 @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  quizzes            Quiz[]

  @@index([embedding], map: "idx_lesson_chunks_embedding_hnsw")
  @@map("lesson_chunks")
}

model Lesson {
  id             String         @id @default(uuid())
  title          String?
  content        String?
  duration       Int?
  position       Int?
  isPublic       Boolean?       @default(false)
  type           String?
  url            String?
  chapterId      String?
  transcriptId   String?        @unique
  transcript     String?
  summary        String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  deleted        Boolean        @default(false)
  subtitles      String?
  suggestedTitle String?
  isQualityValid Boolean?       @default(true)
  qualityReason  String?
  status         AnalysisStatus @default(PROCESSING)
  chunks         LessonChunk[]

  @@map("lessons")
}

model NavigatorEmbedding {
  id          String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  category    String
  subcategory String?
  title       String?
  content     String
  metadata    Json?
  createdAt   DateTime?              @default(now()) @map("created_at") @db.Timestamptz(6)
  check       Boolean?               @default(true)
  embedding   Unsupported("vector")?

  @@map("navigator_embeddings")
}

model QuizChoice {
  id           String         @id @default(uuid())
  quizId       String
  text         String
  isCorrect    Boolean        @default(false)
  order        Int
  feedback     String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  quiz         Quiz           @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@index([quizId])
  @@map("quiz_choices")
}

model Quiz {
  id           String          @id @default(uuid())
  chunkId      String
  question     String
  explanation  String
  type         QuestionType    @default(MULTIPLE_CHOICE)
  difficulty   DifficultyLevel @default(MEDIUM)
  bloomLevel   BloomLevel      @default(REMEMBER)
  aiGenerated  Boolean         @default(false)
  aiModel      String?
  aiConfidence Float?
  createdBy    String
  isApproved   Boolean         @default(false)
  status       QuizStatus      @default(ACTIVE)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  choices      QuizChoice[]
  chunk        LessonChunk     @relation(fields: [chunkId], references: [id], onDelete: Cascade)

  @@index([aiGenerated])
  @@index([chunkId])
  @@index([createdBy])
  @@index([isApproved])
  @@map("quizzes")
}

model SystemProfileEmbedding {
  id          String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  category    String
  subcategory String?
  title       String?
  content     String
  metadata    Json?
  createdAt   DateTime?              @default(now()) @map("created_at") @db.Timestamptz(6)
  check       Boolean?
  embedding   Unsupported("vector")?

  @@map("system_profile_embeddings")
}

model UserPurchasedCourse {
  id          BigInt    @id
  userId      String    @map("user_id")
  courseId    String    @map("course_id")
  purchasedAt DateTime? @default(now()) @map("purchased_at") @db.Timestamp(6)

  @@map("user_purchased_courses")
}

model n8n_chat_histories {
  id         Int    @id @default(autoincrement())
  session_id String @db.VarChar(255)
  message    Json
}

enum BloomLevel {
  REMEMBER
  UNDERSTAND
  APPLY
  ANALYZE
  EVALUATE
  CREATE
}

enum DifficultyLevel {
  EASY
  MEDIUM
  HARD
}

enum QuestionType {
  MULTIPLE_CHOICE
  TRUE_FALSE
  SHORT_ANSWER
}

enum QuizStatus {
  ACTIVE
  ARCHIVED
  FLAGGED
}

enum AnalysisStatus {
  PROCESSING
  COMPLETED
  FAILED
}
